# Dependencies
node_modules/

# Production build (publish dist/ to gh-pages separately)
dist/

# Local env files (secrets, overrides)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/

# Vite
*.local

# draw.io editor (fetched by scripts/vendor-drawio.js on npm install)
public/drawio/

# Hoppscotch API client (fetched by scripts/vendor-hoppscotch.js on npm install)
public/hoppscotch/

# ArtCraft web apps (unpacked from third-party/ by scripts/vendor-crafts.js)
public/crafts/

# SQLite WASM (unpacked from sqlite-wasm-3540000.zip by scripts/vendor-sqlite.js)
public/sqlite/

# Pyodide (unpacked from pyodide-314.0.7.tar.bz2 by scripts/vendor-pyodide.js)
public/pyodide/

# JupyterLite (built by scripts/vendor-jupyterlite.js)
public/jupyterlite/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

